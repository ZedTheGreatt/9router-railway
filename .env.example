# --- Set these in the Railway template editor as ${{ secret(32) }} ---
# Dashboard session signing key. Without it, 9Router writes an auto-generated
# secret into the volume; setting it explicitly keeps sessions valid across
# redeploys and volume resets.
JWT_SECRET=

# HMAC secret for the API keys you issue from the dashboard.
API_KEY_SECRET=

# Salt for stable machine-ID hashing.
MACHINE_ID_SALT=

# --- Set this yourself. Upstream default is 123456 — never ship that on a
# public Railway domain. ---
INITIAL_PASSWORD=

# --- Pre-set in railway.toml, listed here for local `docker run --env-file` ---
PORT=20128
DATA_DIR=/app/data
BASE_URL=http://localhost:20128
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=true
ENABLE_REQUEST_LOGS=false
